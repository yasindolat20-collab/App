# ---------------------------------------------------------------------------
# Ω-SIB configuration. Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database --------------------------------------------------------------
# SQLite for development (default when unset):
DATABASE_URL=sqlite:///./backend/data/omega_sib.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://omega_sib:omega_sib@localhost:5432/omega_sib

# --- Bootstrap administrator (created by `python -m app.seed`) -------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Dr. Sara Alavi
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- AI interface (Ω-Chat) -------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. When these are empty the
# assistant answers from the deterministic clinical rules engine instead.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1600

# --- SIB bridge ------------------------------------------------------------
# simulator = local, deterministic (development/demo)
# http      = forward transactions to a real SIB gateway
SIB_ADAPTER=simulator
SIB_ADAPTER_URL=
SIB_ADAPTER_TOKEN=
SIB_SIMULATED_FAILURE_RATE=0

# --- Frontend / serving ----------------------------------------------------
CORS_ORIGINS=*
SERVE_FRONTEND=true
FRONTEND_DIST=./frontend/dist
SEED_DEMO_DATA=true
AUDIT_ENABLED=true

# --- Frontend build (Vite) -------------------------------------------------
# Leave empty when the API serves the built frontend from the same origin.
VITE_API_BASE=